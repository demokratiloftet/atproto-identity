{
  "name": "loftet-identity-component",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.17 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:package": "node scripts/test-package.ts",
    "pack": "pnpm run build && node scripts/pack.ts",
    "build": "node scripts/build.ts",
    "typecheck": "pnpm run build && tsc --noEmit",
    "pretest": "pnpm run typecheck",
    "format": "prettier --write packages test scripts",
    "format:check": "prettier --check packages test scripts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "jose": "6.2.12",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "@loftet/auth": "workspace:*",
    "@loftet/identity": "workspace:*"
  },
  "packageManager": "pnpm@11.8.0"
}
